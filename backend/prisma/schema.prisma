// Prisma schema — connect to Supabase PostgreSQL
// Docs: https://pris.ly/d/prisma-schema
//
// Local app + production DB: use Session mode (port 5432) for migrations,
// Transaction pooler (6543) for app runtime if needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEADER
  MEMBER
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  password        String
  name            String
  phone           String?
  role            Role
  locked          Boolean           @default(false)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships      WorkspaceMember[]
  spaceMemberships SpaceMember[]
  assignedTasks    Task[]            @relation("TaskAssignee")
  reportedTasks    Task[]            @relation("TaskReporter")

  @@map("users")
}

enum AccessType {
  PRIVATE
  PUBLIC
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

enum MemberStatus {
  ACTIVE
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  description String?
  icon        String?
  iconMime    String?           @map("icon_mime")
  accessType  AccessType        @default(PRIVATE) @map("access_type")
  status      WorkspaceStatus   @default(ACTIVE)
  ownerId     String            @map("owner_id")
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")
  members     WorkspaceMember[]
  invitations Invitation[]
  iconFile    WorkspaceIcon?
  spaces      Space[]

  @@index([deletedAt, status])
  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceIcon {
  workspaceId String    @id @map("workspace_id")
  data        Bytes
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_icons")
}

model WorkspaceMember {
  id          String       @id @default(cuid())
  workspaceId String       @map("workspace_id")
  userId      String       @map("user_id")
  role        Role
  status      MemberStatus @default(ACTIVE)
  joinedAt    DateTime     @default(now()) @map("joined_at")
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Invitation {
  id          String             @id @default(cuid())
  email       String
  workspaceId String             @map("workspace_id")
  role        Role
  token       String             @unique
  status      InvitationStatus   @default(PENDING)
  invitedBy   String             @map("invited_by")
  invitedAt   DateTime           @default(now()) @map("invited_at")
  expiresAt   DateTime           @map("expires_at")
  acceptedAt  DateTime?          @map("accepted_at")
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email, status])
  @@map("invitations")
}

enum SpaceIcon {
  ARCHIVE
  BOARD
  SPARK
  REPORTS
  MEMBERS
}

enum SpaceColor {
  BLUE
  PURPLE
  TEAL
  ORANGE
}

enum SpaceView {
  KANBAN
  LIST
  CALENDAR
  AGILE
}

model Space {
  id          String       @id @default(cuid())
  workspaceId String       @map("workspace_id")
  name        String
  description String?
  icon        SpaceIcon    @default(ARCHIVE)
  color       SpaceColor   @default(BLUE)
  accessType  AccessType   @default(PRIVATE) @map("access_type")
  views       SpaceView[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     SpaceMember[]
  statuses    SpaceStatus[]
  lists       WorkList[]
  tasks       Task[]

  @@index([workspaceId, deletedAt])
  @@map("spaces")
}

model SpaceMember {
  id      String @id @default(cuid())
  spaceId String @map("space_id")
  userId  String @map("user_id")
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([spaceId, userId])
  @@index([userId])
  @@map("space_members")
}

model SpaceStatus {
  id       String @id @default(cuid())
  spaceId  String @map("space_id")
  name     String
  position Int
  space    Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@index([spaceId, position])
  @@map("space_statuses")
}

model WorkList {
  id          String    @id @default(cuid())
  spaceId     String    @map("space_id")
  name        String
  description String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([spaceId, deletedAt])
  @@map("work_lists")
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

model Task {
  id          String       @id @default(cuid())
  spaceId     String       @map("space_id")
  listId      String       @map("list_id")
  code        String
  title       String
  description String?
  statusId    String       @map("status_id")
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?      @map("assignee_id")
  reporterId  String       @map("reporter_id")
  dueAt       DateTime?    @map("due_at")
  position    Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")
  space       Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  list        WorkList     @relation(fields: [listId], references: [id], onDelete: Cascade)
  status      SpaceStatus  @relation(fields: [statusId], references: [id], onDelete: Restrict)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter    User         @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: Restrict)

  @@index([spaceId, deletedAt])
  @@index([listId])
  @@map("tasks")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String   @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  result     String
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([actorId])
  @@map("audit_logs")
}

model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_checks")
}
