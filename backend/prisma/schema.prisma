// Prisma schema — connect to Supabase PostgreSQL
// Docs: https://pris.ly/d/prisma-schema
//
// Local app + production DB: use Session mode (port 5432) for migrations,
// Transaction pooler (6543) for app runtime if needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEADER
  MEMBER
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  password        String
  name            String
  phone           String?
  role            Role
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]

  @@map("users")
}

enum AccessType {
  PRIVATE
  PUBLIC
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

enum MemberStatus {
  ACTIVE
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  description String?
  icon        String?
  iconMime    String?           @map("icon_mime")
  accessType  AccessType        @default(PRIVATE) @map("access_type")
  status      WorkspaceStatus   @default(ACTIVE)
  ownerId     String            @map("owner_id")
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")
  members     WorkspaceMember[]
  invitations Invitation[]
  iconFile    WorkspaceIcon?

  @@index([deletedAt, status])
  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceIcon {
  workspaceId String    @id @map("workspace_id")
  data        Bytes
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_icons")
}

model WorkspaceMember {
  id          String       @id @default(cuid())
  workspaceId String       @map("workspace_id")
  userId      String       @map("user_id")
  role        Role
  status      MemberStatus @default(ACTIVE)
  joinedAt    DateTime     @default(now()) @map("joined_at")
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Invitation {
  id          String             @id @default(cuid())
  email       String
  workspaceId String             @map("workspace_id")
  role        Role
  token       String             @unique
  status      InvitationStatus   @default(PENDING)
  invitedBy   String             @map("invited_by")
  invitedAt   DateTime           @default(now()) @map("invited_at")
  expiresAt   DateTime           @map("expires_at")
  acceptedAt  DateTime?          @map("accepted_at")
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email, status])
  @@map("invitations")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String   @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  result     String
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([actorId])
  @@map("audit_logs")
}

model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_checks")
}
